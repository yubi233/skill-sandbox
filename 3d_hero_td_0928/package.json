{
  "name": "legion-breaker-3d",
  "private": true,
  "version": "0.5.0",
  "description": "死灵防线 · Legion Breaker 3D — Babylon.js 波次防御游戏",
  "scripts": {
    "dev": "npm run gen:textures && vite",
    "build": "npm run gen:textures && vite build && node scripts/copy-artifact.mjs",
    "gen:textures": "node scripts/gen-textures.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts && node --test tests/*.test.js",
    "test:legacy": "node --test tests/*.test.js",
    "build:legacy": "node dev/build.mjs",
    "verify": "npm run typecheck && npm run build && npm run test && npm run sim",
    "sim": "tsx tools/headless_sim.ts",
    "sim:stress": "tsx tools/headless_sim.ts --stress"
  },
  "dependencies": {
    "@babylonjs/core": "7.54.3"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vite-plugin-singlefile": "^2.0.2"
  }
}